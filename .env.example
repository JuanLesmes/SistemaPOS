# Copie este archivo como .env junto al ejecutable (o en la raíz del proyecto) y
# complete los valores. El archivo .env no se sube al repositorio.

# Conexión a PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=inventario
DB_USER=postgres
DB_PASSWORD=

# Clave del primer administrador (usuario: admin). Solo se usa cuando la base
# todavía no tiene usuarios; después se administra desde la pantalla Usuarios.
ADMIN_PASSWORD=
