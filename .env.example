# Copie este archivo como .env junto al ejecutable (o en la raíz del proyecto) y
# complete los valores. El archivo .env no se sube al repositorio.

# Conexión a PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=inventario
DB_USER=postgres
DB_PASSWORD=

# Clave temporal para entrar a la auditoría. Se reemplazará por usuarios con roles.
ADMIN_PASSWORD=
